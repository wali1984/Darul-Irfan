    "The high-latitude rule adjusts Fajr and Isha in places where twilight lasts unusually long. Automatic follows the recommended rule for your location.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The high-latitude rule adjusts Fajr and Isha in places where twilight lasts unusually long. Automatic follows the recommended rule for your location."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بلند عرض بلد کا اصول ان مقامات پر فجر اور عشاء کو درست کرتا ہے جہاں شفق غیر معمولی دیر تک رہتی ہے۔ خودکار آپ کے مقام کے لیے تجویز کردہ اصول اپناتا ہے۔"
          }
