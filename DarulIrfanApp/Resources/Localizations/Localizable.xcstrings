        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک ترتیبات ایپ میں اطلاعات کی اجازت نہ ہو، نماز کے الرٹس خاموش رہتے ہیں۔"
          }
        }
      }
    },
    "Prayer reminder": {
