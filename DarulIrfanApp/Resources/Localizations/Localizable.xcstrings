          }
        }
      }
    },
    "Prayer times and the Qibla direction are calculated locally. Your coordinates are never sent to a server, and no location history is kept — only the city used for calculations is saved, with its coordinates rounded to city-level accuracy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer times and the Qibla direction are calculated locally. Your coordinates are never sent to a server, and no location history is kept — only the city used for calculations is saved, with its coordinates rounded to city-level accuracy."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز کے اوقات اور قبلے کی سمت کا حساب مقامی طور پر ہوتا ہے۔ آپ کے کوآرڈینیٹس کبھی کسی سرور کو نہیں بھیجے جاتے، اور مقام کی کوئی سرگزشت نہیں رکھی جاتی — صرف حساب کے لیے استعمال ہونے والا شہر محفوظ ہوتا ہے، جس کے کوآرڈینیٹس شہر کی سطح تک محدود کیے جاتے ہیں۔"
          }
        }
      }
    },
    "Prayer times and the Qibla direction depend on where you are.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer times and the Qibla direction depend on where you are."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز کے اوقات اور قبلے کی سمت کا انحصار آپ کے مقام پر ہے۔"
          }
        }
      }
    },
    "Prayer times are calculated entirely on this device using the open-source adhan-swift library by Batoul Apps, used under the MIT License.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
