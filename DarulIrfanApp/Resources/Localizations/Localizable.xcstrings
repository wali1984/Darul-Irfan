    "When enabled, new content packs are fetched automatically while you are on Wi-Fi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, new content packs are fetched automatically while you are on Wi-Fi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فعال ہونے پر، وائی فائی سے منسلک ہوتے ہوئے نئے مواد کے پیک خودکار طور پر حاصل کیے جاتے ہیں۔"
          }
        }
      }
    },
    "When the Isha interval is set, Isha is that many minutes after Maghrib and the Isha angle is not used.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the Isha interval is set, Isha is that many minutes after Maghrib and the Isha angle is not used."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب عشاء کا وقفہ مقرر ہو تو عشاء مغرب کے اتنے منٹ بعد ہوتی ہے اور عشاء کا زاویہ استعمال نہیں ہوتا۔"
          }
        }
      }
    },
    "While reading, tap the bookmark icon on any ayah and it will be kept here for you.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While reading, tap the bookmark icon on any ayah and it will be kept here for you."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تلاوت کے دوران کسی بھی آیت پر نشانی کے نشان کو چھوئیں، وہ یہاں آپ کے لیے محفوظ رہے گی۔"
          }
        }
      }
    },
