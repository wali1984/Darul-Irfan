    "Darul Irfan can play a short, gentle azan clip when each prayer time arrives.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Darul Irfan can play a short, gentle azan clip when each prayer time arrives."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دارالعرفان ہر نماز کا وقت آنے پر ایک مختصر اور نرم اذان کلپ چلا سکتا ہے۔"
          }
        }
      }
    },
    "Darul Irfan contains no advertising, no third-party trackers, and no analytics. Nothing about your reading, listening, or prayer habits leaves your device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Darul Irfan contains no advertising, no third-party trackers, and no analytics. Nothing about your reading, listening, or prayer habits leaves your device."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دارالعرفان میں نہ کوئی اشتہار ہے، نہ کسی تیسرے فریق کے ٹریکرز اور نہ تجزیاتی نگرانی۔ آپ کے مطالعے، سماعت یا نماز کے معمولات کی کوئی بات آپ کی ڈیوائس سے باہر نہیں جاتی۔"
          }
        }
      }
    },
    "Darul Irfan is the companion app of Silsila Naqshbandia Owaisiah, a Sufi order whose spiritual lineage traces to Khawajah Owais Qarni. The order's method is Zikr-e Khafi Qalbi with Pas Anfas — \"guarding every breath\". A distinguishing feature of the Owaisiah way is spiritual bai'at directly at the hands of the holy Prophet ﷺ.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Darul Irfan is the companion app of Silsila Naqshbandia Owaisiah, a Sufi order whose spiritual lineage traces to Khawajah Owais Qarni. The order's method is Zikr-e Khafi Qalbi with Pas Anfas — \"guarding every breath\". A distinguishing feature of the Owaisiah way is spiritual bai'at directly at the hands of the holy Prophet ﷺ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دارالعرفان سلسلہ نقشبندیہ اویسیہ کی معاون ایپ ہے — ایک ایسا صوفی سلسلہ جس کی روحانی نسبت خواجہ اویس قرنی تک پہنچتی ہے۔ سلسلے کا طریقہ ذکرِ خفی قلبی مع پاسِ انفاس ہے — یعنی \"ہر سانس کی نگہبانی\"۔ اویسیہ طریق کی امتیازی خصوصیت حضور نبی کریم ﷺ کے دستِ مبارک پر براہِ راست روحانی بیعت ہے۔"
          }
        }
      }
    },
    "Darul Irfan uses notifications only for prayer alerts and the reminders you set.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Darul Irfan uses notifications only for prayer alerts and the reminders you set."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دارالعرفان اطلاعات صرف نماز کے الرٹس اور آپ کی مقرر کردہ یاد دہانیوں کے لیے استعمال کرتا ہے۔"
          }
        }
      }
    },
