    "Bookmarks, prayer records, tasbih counts, and downloads are stored only on this device. Deleting the app removes them completely.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookmarks, prayer records, tasbih counts, and downloads are stored only on this device. Deleting the app removes them completely."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نشانیاں، نماز کے اندراجات، تسبیح کے شمار اور ڈاؤن لوڈز صرف اسی ڈیوائس پر محفوظ ہوتے ہیں۔ ایپ حذف کرنے سے یہ مکمل طور پر ختم ہو جاتے ہیں۔"
          }
        }
      }
    },
    "Books": {
      "extractionState": "manual",
