        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگلی تصدیق شدہ اپ ڈیٹ کے بعد اس حصے کا مواد خود بخود ظاہر ہو گا۔"
          }
        }
      }
    },
    "Programs at Dar-ul-Irfan will appear here automatically when they are announced.": {
      "extractionState": "manual",
