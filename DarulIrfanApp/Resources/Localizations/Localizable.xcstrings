    "We couldn't determine your location right now. Please try again in a moment, or choose your city manually below.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't determine your location right now. Please try again in a moment, or choose your city manually below."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم اس وقت آپ کا مقام معلوم نہیں کر سکے۔ براہِ کرم تھوڑی دیر بعد دوبارہ کوشش کریں، یا نیچے اپنا شہر خود منتخب کریں۔"
          }
        }
      }
    },
    "We couldn't determine your location. You can allow location access in iOS Settings, or choose a city from the More tab under Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't determine your location. You can allow location access in iOS Settings, or choose a city from the More tab under Settings."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم آپ کا مقام معلوم نہیں کر سکے۔ آپ iOS کی ترتیبات میں مقام کی اجازت دے سکتے ہیں، یا مزید ٹیب میں ترتیبات سے کوئی شہر منتخب کر سکتے ہیں۔"
          }
        }
      }
    },
