          }
        }
      }
    },
    "Books, articles, and announcements will appear here after the first content update. Until then, the full collection is available at naqshbandiaowaisiah.org.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Books, articles, and announcements will appear here after the first content update. Until then, the full collection is available at naqshbandiaowaisiah.org."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کتابیں، مضامین اور اعلانات پہلی مواد اپ ڈیٹ کے بعد یہاں ظاہر ہوں گے۔ اس وقت تک مکمل ذخیرہ naqshbandiaowaisiah.org پر دستیاب ہے۔"
          }
        }
      }
    },
