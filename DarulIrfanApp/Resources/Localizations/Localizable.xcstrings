    "Alerts use this short chime so they stay within the iOS notification sound limit. Full recitations can be played inside the app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts use this short chime so they stay within the iOS notification sound limit. Full recitations can be played inside the app."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الرٹس یہ مختصر گھنٹی استعمال کرتے ہیں تاکہ iOS کی اطلاعاتی آواز کی حد میں رہیں۔ مکمل اذان ایپ کے اندر چلائی جا سکتی ہے۔"
          }
        }
      }
    },
