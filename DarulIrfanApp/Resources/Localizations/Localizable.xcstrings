        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تلاوت کے دوران کسی بھی آیت پر نشانی کے نشان کو چھوئیں، وہ یہاں آپ کے لیے محفوظ رہے گی۔"
          }
