    "Your location stays on this device. It is used only to calculate prayer times and the Qibla direction, and is never sent to any server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location stays on this device. It is used only to calculate prayer times and the Qibla direction, and is never sent to any server."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا مقام اسی ڈیوائس پر رہتا ہے۔ یہ صرف نماز کے اوقات اور قبلے کی سمت کے حساب کے لیے استعمال ہوتا ہے اور کبھی کسی سرور کو نہیں بھیجا جاتا۔"
          }
        }
      }
    },
    "Your precise location is never stored — only the resolved city name and approximate, city-level coordinates are kept so prayer times work offline.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your precise location is never stored — only the resolved city name and approximate, city-level coordinates are kept so prayer times work offline."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا درست مقام کبھی محفوظ نہیں کیا جاتا — صرف شہر کا نام اور شہر کی سطح کے تخمینی کوآرڈینیٹس رکھے جاتے ہیں تاکہ نماز کے اوقات آف لائن بھی کام کریں۔"
          }
        }
      }
    },
