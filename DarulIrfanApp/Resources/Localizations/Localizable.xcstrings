    "About the order, its lineage, and its method": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About the order, its lineage, and its method"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سلسلے کا تعارف، اس کی سند اور اس کا طریقہ"
          }
        }
      }
    },
    "Accurate prayer times and gentle azan reminders, the Holy Quran with translation and tafsir, lectures and books from the Naqshbandia Owaisiah library, and guidance for daily zikr — together in one calm companion.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accurate prayer times and gentle azan reminders, the Holy Quran with translation and tafsir, lectures and books from the Naqshbandia Owaisiah library, and guidance for daily zikr — together in one calm companion."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درست اوقاتِ نماز اور نرم اذان یاد دہانیاں، ترجمہ و تفسیر کے ساتھ قرآنِ کریم، نقشبندیہ اویسیہ کتب خانے کے خطابات اور کتابیں، اور روزانہ ذکر کی رہنمائی — سب کچھ ایک پُرسکون رفیق میں یکجا۔"
          }
        }
      }
    },
