    "99 Names of Allah": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "99 Names of Allah"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اللہ کے 99 نام"
          }
        }
      }
    },
    "99 Names, duas, Islamic days and tasbih": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "99 Names, duas, Islamic days and tasbih"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "99 نام، دعائیں، اسلامی ایام اور تسبیح"
          }
        }
      }
    },
    "A distinguishing feature of this order is spiritual bai'at directly at the hands of the holy Prophet ﷺ — the Owaisiah transmission.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A distinguishing feature of this order is spiritual bai'at directly at the hands of the holy Prophet ﷺ — the Owaisiah transmission."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سلسلے کی امتیازی خصوصیت حضور نبی کریم ﷺ کے دستِ مبارک پر براہِ راست روحانی بیعت ہے — یعنی اویسی نسبت۔"
          }
        }
      }
    },
    "A gentle azan at each prayer time, only if you'd like.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle azan at each prayer time, only if you'd like."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر نماز کے وقت ایک نرم اذان، صرف آپ کی خواہش پر۔"
          }
        }
      }
    },
    "A gentle heads-up before Fajr, Dhuhr, Asr, Maghrib and Isha.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle heads-up before Fajr, Dhuhr, Asr, Maghrib and Isha."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فجر، ظہر، عصر، مغرب اور عشاء سے پہلے ایک نرم اطلاع۔"
          }
        }
      }
    },
    "A location is needed for prayer times": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A location is needed for prayer times"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز کے اوقات کے لیے مقام درکار ہے"
          }
        }
      }
    },
    "A per-session goal such as 100. Leave empty for open-ended counting.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A per-session goal such as 100. Leave empty for open-ended counting."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فی نشست ہدف، مثلاً 100۔ غیر محدود شمار کے لیے خالی چھوڑ دیں۔"
          }
        }
      }
    },
