    "By default, Fajr, Dhuhr, Asr, Maghrib, and Isha each use the azan clip, and sunrise stays silent. You can adjust every prayer's alert in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default, Fajr, Dhuhr, Asr, Maghrib, and Isha each use the azan clip, and sunrise stays silent. You can adjust every prayer's alert in Settings."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "طے شدہ طور پر فجر، ظہر، عصر، مغرب اور عشاء کے لیے اذان کلپ چلتا ہے جبکہ طلوعِ آفتاب خاموش رہتا ہے۔ ہر نماز کا الرٹ ترتیبات میں بدلا جا سکتا ہے۔"
          }
        }
      }
    },
