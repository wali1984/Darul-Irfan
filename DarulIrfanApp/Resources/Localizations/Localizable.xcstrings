    "Adjust by up to two days if your local moon sighting differs from the calculated Umm al-Qura calendar. Islamic day reminders follow this setting.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust by up to two days if your local moon sighting differs from the calculated Umm al-Qura calendar. Islamic day reminders follow this setting."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر آپ کی مقامی رؤیتِ ہلال حساب شدہ امّ القریٰ کیلنڈر سے مختلف ہو تو زیادہ سے زیادہ دو دن کی ایڈجسٹمنٹ کریں۔ اسلامی ایام کی یاد دہانیاں اسی ترتیب کے مطابق چلتی ہیں۔"
          }
        }
      }
    },
