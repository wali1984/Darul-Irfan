{
  "sourceLanguage" : "en",
  "strings" : {
    "NSSpeechRecognitionUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you lead the live Zikr, Darul Irfan recognises Hazrat ji's words on this phone to show the stage he announces. Nothing he says is stored."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب آپ براہِ راست ذکر کی قیادت کریں تو دارالعرفان اسی فون پر حضرت جی کے الفاظ پہچان کر وہ مرحلہ دکھاتا ہے جس کا وہ اعلان کریں۔ ان کی کوئی بات محفوظ نہیں کی جاتی۔"
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darul Irfan adds community events such as the Monthly Ijtema to your calendar only when you ask it to."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دارالعرفان صرف آپ کے کہنے پر ماہانہ اجتماع جیسے اجتماعی پروگرام آپ کے کیلنڈر میں شامل کرتا ہے۔"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darul Irfan uses your location for prayer times, Qibla and local weather. Approximate location is sent to our weather service."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دارالعرفان آپ کا مقام نماز کے اوقات، قبلے کی سمت اور مقامی موسم کے لیے استعمال کرتا ہے۔ اندازاً مقام ہماری موسمی معلومات کی سروس کو بھیجا جاتا ہے۔"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darul Irfan uses the camera only when you join a Halqah meeting and turn your video on."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دارالعرفان کیمرا صرف اس وقت استعمال کرتا ہے جب آپ حلقے کی میٹنگ میں شامل ہو کر اپنی ویڈیو آن کریں۔"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darul Irfan uses the microphone when you choose to speak in a Halqah, record your recitation for private memorization practice, or, leading the live Zikr, let the stage follow Hazrat ji's voice."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دارالعرفان مائیکروفون اس وقت استعمال کرتا ہے جب آپ حلقے میں بولنا چاہیں، حفظ کی ذاتی مشق کے لیے اپنی تلاوت ریکارڈ کریں، یا براہِ راست ذکر کی قیادت میں اسٹیج کو حضرت جی کی آواز کے ساتھ چلائیں۔"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
