{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCalendarsWriteOnlyAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darul Irfan adds community events such as the Monthly Ijtema to your calendar only when you ask it to."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دارالعرفان صرف آپ کے کہنے پر ماہانہ اجتماع جیسے اجتماعی پروگرام آپ کے کیلنڈر میں شامل کرتا ہے۔"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darul Irfan uses your location for prayer times, Qibla and local weather. Approximate location is sent to our weather service."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دارالعرفان آپ کا مقام نماز کے اوقات، قبلے کی سمت اور مقامی موسم کے لیے استعمال کرتا ہے۔ اندازاً مقام ہماری موسمی معلومات کی سروس کو بھیجا جاتا ہے۔"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darul Irfan uses the camera only when you join a Halqah meeting and turn your video on."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دارالعرفان کیمرا صرف اس وقت استعمال کرتا ہے جب آپ حلقے کی میٹنگ میں شامل ہو کر اپنی ویڈیو آن کریں۔"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darul Irfan uses the microphone when you choose to speak in a Halqah or record your recitation for private memorization practice."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دارالعرفان مائیکروفون اس وقت استعمال کرتا ہے جب آپ حلقے میں بولنا چاہیں یا حفظ کی ذاتی مشق کے لیے اپنی تلاوت ریکارڈ کریں۔"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
