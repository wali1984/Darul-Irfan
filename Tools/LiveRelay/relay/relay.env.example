# Copy to relay.env (never committed).
WORKER_URL=https://darul-irfan-live-staging.wajidmahmoodali1984-e23.workers.dev
RELAY_KEY=<RELAY_KEY from Darul Irfan/live-relay-staging.md>
RELAY_ID=lightsail-a
# 1 = never touches the room's mic or chat (always 1 in Our Sheikh).
LISTEN_ONLY=1
# The room as Paltalk's search lists it, and text that identifies it once
# joined (its topic line; the room name itself is drawn as a picture).
PALTALK_ROOM=Our Sheikh
ROOM_MARKERS=naqsh bandia
# The relay's own Paltalk name, so its posts are not read back as cues.
PALTALK_USER=
# Hosts whose chat lines are stage cues.
CUE_HOSTS=ameer_imam,ghazi_faiz,siqarian2
# Paltalk's speaker plays into this cable; the relay records its other end.
ROOM_CAPTURE_DEVICE=CABLE Output (VB-Audio Virtual
# Two-way only: the relay plays the app broadcast here; Paltalk's mic is its other end.
MIC_DEVICE=Hi-Fi Cable Input
# Optional: rtmp://a.rtmp.youtube.com/live2/<stream key>
YOUTUBE_URL=
# The room by id (Our Sheikh = 463712; https://paltalk.im/egnMPD3Y resolves to it).
PALTALK_ROOM_LINK=paltalk://group/463712
# Second output (optional): rtmps://live-api-s.facebook.com:443/rtmp/<persistent stream key>
FACEBOOK_URL=
# The platform: Paltalk cues go to its cue list (one source of truth) and the
# YouTube/Facebook picture is the websites' /broadcast page for this Halqah.
PLATFORM_URL=https://darul-irfan-platform.wajidmahmoodali1984-e23.workers.dev
HALQAH_ID=our-sheikh
BROADCAST_PAGE=https://oursheikh.wajidali.us/broadcast?halqah=our-sheikh
# The platform's LISTENER_TOKEN (service route /v1/service/groups/:id/zikr-cues).
PLATFORM_CUE_TOKEN=
# --- Since the 2026-11-06 review ---
# 0 = never send the room's sound to listeners (tests in other rooms).
PUBLISH_AUDIO=1
# 1 = run the "Darul Irfan Stage" virtual camera (not proven: other members got no picture).
PALTALK_CAMERA=0
# Tests: put overrides in relay.override.env next to this file (same KEY=value
# lines); it is read after relay.env. Delete it to return to production.
# YouTube's broadcast is made by the relay through the YouTube API when
# youtube-oauth-client.json and youtube-token.json (youtube_auth.py) sit
# beside it: title, privacy (public, unlisted, private) and description.
YOUTUBE_TITLE=Online Zikr with Sheikh-ul-Mukarram Hazrat Ameer Abdul Qadeer Awan MZA
YOUTUBE_PRIVACY=public
YOUTUBE_DESCRIPTION=
